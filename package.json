{
  "name": "personal-os-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:build && playwright test",
    "test:e2e:build": "NEXT_PUBLIC_APP_URL=https://localhost:3443 DATABASE_URL=postgresql://aios:aios@localhost:5432/aios_ws5 next build --turbopack",
    "test:e2e:run": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:encrypt-tokens": "tsx scripts/encrypt-integration-tokens.ts",
    "db:integrity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-integrity.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
