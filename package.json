    "@upstash/redis": "^1.38.2",
    "ai": "^7.0.77",
    "bcrypt": "^6.0.0",
    "chrono-node": "2.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "googleapis": "^176.0.0",
