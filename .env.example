# Database (Neon Postgres pooled connection string)
DATABASE_URL=

# Auth.js (Google OAuth)
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: from a Google Cloud OAuth 2.0 Client ID
# (Google Cloud Console > APIs & Services > Credentials). Enable the Gmail API
# and Google Calendar API on the same project, and add the Gmail
# (gmail.readonly, gmail.compose) and Calendar (calendar.readonly) scopes to
# the OAuth consent screen.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Anthropic (used by @ai-sdk/anthropic in lib/ai/orchestrator.ts and
# inngest/daily-briefing.ts, model "claude-sonnet-5"). Get a key from
# console.anthropic.com.
ANTHROPIC_API_KEY=

# Voyage AI (used directly via fetch in lib/ai/embeddings.ts to generate
# memory embeddings). Get a key from dash.voyageai.com.
VOYAGE_API_KEY=

# Tavily (used by the web search tool capability in app/api/command/route.ts).
# Get a key from tavily.com.
TAVILY_API_KEY=

# Upstash Redis (used by lib/rate-limit.ts via Redis.fromEnv() to rate-limit
# AI and integration calls). Get the REST URL/token from the Upstash console's
# Redis database "REST API" tab. NOTE: Redis.fromEnv() runs at module load
# time, so set these at BUILD time on Vercel too (not just runtime) -
# otherwise the build only warns ("[Upstash Redis] Unable to find
# environment variable") but ships a client with an undefined url/token, and
# every rate-limited request fails at runtime instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest (read automatically by the Inngest SDK in inngest/client.ts and the
# serve() handler in app/api/inngest/route.ts). Get these from the Inngest
# dashboard after connecting the app at /api/inngest. Not required for local
# dev against the Inngest Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
