# Database (Neon Postgres pooled connection string)
DATABASE_URL=

# Session JWT signing secret, used by lib/auth/jwt.ts (imported by both
# middleware.ts and lib/auth/session.ts). Generate with
# `openssl rand -base64 33`. Must be at least 32 bytes.
JWT_SECRET=

# Auth.js (Google OAuth) — legacy provider, being replaced by the hand-rolled
# flow below; still referenced by auth.ts until that cutover lands.
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: from a Google Cloud OAuth 2.0 Client ID
# (Google Cloud Console > APIs & Services > Credentials). Enable the Gmail API
# and Google Calendar API on the same project, and add the Gmail
# (gmail.readonly, gmail.compose) and Calendar (calendar.readonly) scopes to
# the OAuth consent screen.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Hand-rolled Google OAuth (lib/auth/google-oauth.ts, app/api/auth/google/*,
# lib/integrations/google/refresh-token.ts). Can point at the same Google
# Cloud OAuth 2.0 Client ID as AUTH_GOOGLE_ID/SECRET above — just add
# {NEXT_PUBLIC_APP_URL}/api/auth/google/callback as an additional Authorized
# redirect URI on that client, alongside Auth.js's callback URL.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: from the same Google Cloud OAuth
# 2.0 Client ID as above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hand-rolled GitHub OAuth (lib/auth/github-oauth.ts, app/api/auth/github/*).
# Create a GitHub OAuth App at github.com/settings/developers > OAuth Apps.
# Set the homepage URL to NEXT_PUBLIC_APP_URL and callback URL to
# {NEXT_PUBLIC_APP_URL}/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NEXT_PUBLIC_APP_URL: this app's own base URL (e.g. http://localhost:3000
# locally), used to build the OAuth redirect_uri. Public (NEXT_PUBLIC_) since
# it's not a secret and the redirect_uri must match exactly on both the
# authorization request and the token exchange. Also required at build/module
# load time by lib/auth/webauthn.ts (passkey RP ID/origin) -- leaving this
# empty fails `next build` immediately. Set to your real deployment URL in
# production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (used by lib/auth/otp.ts to send OTP verification emails).
# Get a key from resend.com/api-keys.
RESEND_API_KEY=

# Anthropic (used by @ai-sdk/anthropic in lib/ai/orchestrator.ts and
# inngest/daily-briefing.ts, model "claude-sonnet-5"). Get a key from
# console.anthropic.com.
ANTHROPIC_API_KEY=

# Voyage AI (used directly via fetch in lib/ai/embeddings.ts to generate
# memory embeddings). Get a key from dash.voyageai.com.
VOYAGE_API_KEY=

# Tavily (used by the web search tool capability in app/api/command/route.ts).
# Get a key from tavily.com.
TAVILY_API_KEY=

# Upstash Redis (used by lib/rate-limit.ts via Redis.fromEnv() to rate-limit
# AI and integration calls). Get the REST URL/token from the Upstash console's
# Redis database "REST API" tab. NOTE: Redis.fromEnv() runs at module load
# time, so set these at BUILD time on Vercel too (not just runtime) -
# otherwise the build only warns ("[Upstash Redis] Unable to find
# environment variable") but ships a client with an undefined url/token, and
# every rate-limited request fails at runtime instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest (read automatically by the Inngest SDK in inngest/client.ts and the
# serve() handler in app/api/inngest/route.ts). Get these from the Inngest
# dashboard after connecting the app at /api/inngest. Not required for local
# dev against the Inngest Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
