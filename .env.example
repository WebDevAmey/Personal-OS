# Database (Neon Postgres pooled connection string)
DATABASE_URL=

# Auth.js (Google OAuth)
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: from a Google Cloud OAuth 2.0 Client ID
# (Google Cloud Console > APIs & Services > Credentials). Enable the Gmail API
# and Google Calendar API on the same project, and add the Gmail
# (gmail.readonly, gmail.compose) and Calendar (calendar.readonly) scopes to
# the OAuth consent screen.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
